<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Page</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Blog Page</h1>
    <center>
    <a id="btn" href="http://localhost:8080/posts/new">Create new Post</a>
    </center>
    <div class="container">
    <% for(let post of posts) { %>
        <div class="box">
            <h3 class="user">Username: @<%=post.username%></h3>
            <h4 class="content"><%=post.content%></h4>
            <a id="btn" href="http://localhost:8080/posts/<%=post.id%>">See in Detail</a>
            <a id="btn" href="http://localhost:8080/posts/<%=post.id%>/edit">Edit</a>
            <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                <button id="btn" style="width:80px ;height:30px;margin:10px;">DELETE</button>
            </form>
        </div>
    <%}%>
    </div>
</body>
</html>