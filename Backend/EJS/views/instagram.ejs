<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<header>
    <div class="nav">
        <h1>Instagram</h1>

        <div class="nav-buttons">
            <button>Log In</button>
            <a href="#">Sign Up</a>
        </div>
    </div>
</header>

<main>

    <section class="profile">

        <div class="profile-image">
            <img src="https://picsum.photos/200" alt="Profile">
        </div>
        <div class="profile-info">

            <div class="username">
                <h2>@<%=username%></h2>
            </div>

            <div class="stats">
                <p><b>4.5M</b> followers</p>
                <p><b>312</b> following</p>
            </div>

            <h3><%=username%></h3>

            <div class="tag">@<%=username%></div>

            <p class="bio">This meeting could have been an email</p>

            <a href="#">msft.it/6006vYFaE</a>

        </div>

    </section>

    <section class="highlights">

        <div class="highlight">
            <img src="https://picsum.photos/100?random=1">
            <p>MSFT Gardens</p>
        </div>

        <div class="highlight">
            <img src="https://picsum.photos/100?random=2">
            <p>Wallpapers</p>
        </div>

    </section>

    <div class="tabs">
        <span>▦</span>
        <span>▷</span>
        <span>♙</span>
    </div>
    <section class="posts">
        <img src="https://picsum.photos/400/400?random=3">
        <img src="https://picsum.photos/400/400?random=4">
        <img src="https://picsum.photos/400/400?random=5">
        <img src="https://picsum.photos/400/400?random=6">
        <img src="https://picsum.photos/400/400?random=7">
        <img src="https://picsum.photos/400/400?random=8">
    </section>
</main>
</body>
</html>